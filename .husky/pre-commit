# Use the project's Node version (.nvmrc) regardless of the shell's nvm default.
# The hook otherwise inherits the login default (e.g. Node 16), and ESLint 9
# requires Node 18+ (structuredClone). No-op if nvm isn't installed.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use >/dev/null 2>&1 || true
fi

set -e

# 1) Auto-format + lint staged files (per package).
npx lint-staged

# 2) Whole-project typecheck for any package with staged changes
#    (tsc is project-wide, not per-file, so we run it after lint-staged).
staged=$(git diff --cached --name-only)

if echo "$staged" | grep -q '^server/'; then
  echo "> typecheck: server"
  (cd server && npm run --silent typecheck)
fi

if echo "$staged" | grep -q '^client/'; then
  echo "> typecheck: client"
  (cd client && npm run --silent typecheck)
fi
