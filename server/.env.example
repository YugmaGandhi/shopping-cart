# --- Server ---
# Port the API listens on
PORT=4000

# MongoDB connection string (matches docker-compose / docker run in Phase 0.2)
MONGO_URI=mongodb://localhost:27017/shopping-cart

# JWT signing secret — use a long random string in real environments
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime (vercel/ms format: 15m, 1h, 7d, ...)
JWT_EXPIRES_IN=7d

# Allowed CORS origin (the client dev server)
CLIENT_ORIGIN=http://localhost:5173
